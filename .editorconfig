# Editor behaviour, independent of the editor. Biome owns the *formatting* of the
# TypeScript sources (see biome.json); this only tells editors the basics it cannot.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown line breaks are meaningful: two trailing spaces are a <br>.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
