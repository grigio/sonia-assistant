# fullduplex-assistant — configuration template.
# Copy to `.env` (git-ignored) and edit. Bun loads `.env` automatically for
# `bun run` / `bun test` / `bun x`; real shell variables always win over it.
#
# Naming rule: a key is the UPPER_SNAKE form of the field in src/config.ts
# (llmBaseUrl → LLM_BASE_URL). Empty value = "use the built-in default".
# Values with spaces must be quoted: PI_CMD="pi -c" (unquoted also works).
# Paths are used as written; `bun run start` and the scripts always start from the repo root,
# so relative paths (./models) are fine.

# ── language ─────────────────────────────────────────────────────────────────
# LOCALE = it | en — the UI's language and every string the user can see or hear: the
# page (static/index.html), the chat and event lines, the sentences the TTS reads out,
# a tool's result (its card shows it too). Catalogues: UI_STRINGS in static/index.html
# (page) and src/i18n.ts (everything arriving over the WebSocket).
# A POSIX name is fine too (`LOCALE=it_IT.UTF-8` → `it`); anything else falls back to `en`.
# The model's own replies are not set here: the system prompt makes it mirror whatever
# language the user speaks, turn by turn — and it ends with this locale's language default
# (`prompt.langDefault`), which is what keeps `LOCALE=en` from drifting back to Italian.
# A timer is the exception among the spoken strings: it rings minutes later, out of any
# context, so its ring (and the ✕ on its chip) follow the language of the request that set
# it, read off the user's own words — see `detectLocale` in src/i18n.ts.
# data/logs/*.log is a diagnostic stream: always English, never this knob.
LOCALE=it

# ── LLM, API leg (an already-running llama-server, OpenAI-compatible) ────────
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=
LLM_MODEL=Qwen3.5-4B-MTP-Q4_K_M
LLM_MAX_TOKENS=400
LLM_TEMPERATURE=0.7
# 1 = the model may think (a 💭 collapsed block appears in the UI, never spoken)
LLM_DISABLE_THINKING=1
# n_ctx for the header's context bar; 0 = read it from /v1/models
LLM_CONTEXT_WINDOW=0
# 1 = the model may call its tools (timers, notes, shell, skills); 0 = text-only assistant
LLM_ENABLE_TOOLS=1
# Extra tokens the model may think with while LLM_DISABLE_THINKING=0: reasoning and the
# answer share one budget, so LLM_MAX_TOKENS alone would be eaten by the thinking
LLM_REASONING_BUDGET=1536
# Where llama-server keeps its .gguf — documentation only, this app never reads it.
# LLM_MODEL_PATH=/var/lib/llama-server/Qwen3.5-4B-MTP-Q4_K_M.gguf

# ── LLM, pi leg (checkbox "pi CLI" in the UI) ────────────────────────────────
LLM_VIA_PI=0
PI_CMD=pi -c
PI_MODEL=llamacpp/Qwen3.5-4B-MTP-Q4_K_M
PI_THINKING=medium
PI_TIMEOUT_S=300
# Where pi's own session files live (one conv<n> sub-directory each; ~ is expanded).
# Keep it out of the UI suite's way: scripts/ui-test.sh points it at data/run/ui-test-pi.
PI_CWD=./data/pi

# ── speech servers (audio.cpp) ───────────────────────────────────────────────
ASR_URL=http://127.0.0.1:8091
TTS_URL=http://127.0.0.1:8092
TURN_URL=http://127.0.0.1:8093
ASR_MODEL=voxtral
TTS_MODEL=pocket-it
# Which Voxtral package the ASR server serves: q4_k (default, ≈2.9 GB) | q8_0 (≈5.1 GB,
# the accuracy pick) | bf16. Uncommenting it makes `bun run models-download` fetch
# <MODELS_DIR>/Voxtral-Mini-4B-Realtime-2602-GGUF/voxtral-mini-4b-realtime-2602-q8_0.gguf
# and scripts/start-audio-servers.sh serve it as the same model id `voxtral` (audio.cpp
# needs no other change). Restart the ASR server to apply it:
#   scripts/start-audio-servers.sh stop && scripts/start-audio-servers.sh start asr
#ASR_PRECISION=q8_0
# ASR_GGUF=<path> beats ASR_PRECISION, but a hand-picked path has no download source:
# models-download only checks it, so you must place that file yourself.
# Which Pocket TTS pack: italian (default) | english | german | portuguese | spanish.
# It picks the GGUF under <MODELS_DIR>/PocketTTS-GGUF/<lang>/ (fetched by
# `bun run models-download`: ≈209 MiB at bf16, ≈122 MiB at q8_0, plus ≈160 MiB of voices)
# and the `language` load option scripts/start-audio-servers.sh writes into data/run/tts.json.
TTS_LANG=italian
TTS_VOICE=eponine
# voice presets the ⚙ drawer's «voce» selector lists (one <voice>.safetensors per entry);
# empty = <MODELS_DIR>/PocketTTS-GGUF/<TTS_LANG>/embeddings
#TTS_VOICE_DIR=./models/PocketTTS-GGUF/english/embeddings
TURN_MODEL=smart-turn
# What the ASR is told to expect (empty = detect per utterance) and how long the final
# transcript waits for a trailing fragment before it is called final
ASR_LANGUAGE=
ASR_FLUSH_PAD_MS=640
# PipeWire devices for `--cli` (empty = the default source/sink); the browser mode uses
# the tab's own devices, so neither matters there. PLAYBACK_LATENCY_MS is what the player
# pre-rolls before the first sample — `--web` raises it to 150 unless you set it yourself.
MIC_TARGET=
SPK_TARGET=
PLAYBACK_LATENCY_MS=60
# Liveness poll of ASR/TTS/TURN/LLM while the harness runs, in ms (0 = no poller): a dead
# ASR, TTS or LLM leg flips the header orb to `offline` and logs which server went away, a
# dead Smart Turn is logged only (turn-taking then falls back to the silence gap). The mic
# source (pw-record) is not polled: it reports its own death and is restarted with backoff.
#HEALTH_POLL_MS=10000

# ── VAD (Silero, in-process) ───────────────────────────────────────────────
# Speech starts above VAD_START_THRESHOLD (raised to BARGE_VAD_THRESHOLD while the
# assistant talks) and ends below VAD_END_THRESHOLD; VAD_MIN_SPEECH_MS is the shortest
# run of speech that counts as someone talking, PREROLL_MS the audio kept behind it so a
# transcript never starts mid-word.
VAD_START_THRESHOLD=0.5
VAD_END_THRESHOLD=0.35
VAD_MIN_SPEECH_MS=96
PREROLL_MS=480

# ── turn detection (VAD gap → Smart Turn → the LISTEN/REPLY judge) ─────────
# A pause of TURN_CHECK_MS is checked by the Smart Turn classifier; SILENCE_MS of quiet
# ends the turn on its own, MIN_SILENCE_MS is below which nothing is asked at all and
# MAX_SILENCE_MS is how long a turn may stay open. DECISION_MODE = auto asks the judge
# only when the pause is ambiguous (always | off).
TURN_CHECK_MS=200
MIN_SILENCE_MS=300
SILENCE_MS=900
MAX_SILENCE_MS=2500
SMART_TURN_THRESHOLD=0.5
DECISION_MODE=auto

# ── barge-in / echo ────────────────────────────────────────────────────────
# The mic stays open while the assistant talks: BARGE_VAD_THRESHOLD + BARGE_MIN_MS decide
# that someone is talking over the voice, BARGE_CONFIRM_WORDS how many words make it a real
# interruption (less = an echo or a backchannel just pauses it), ECHO_OVERLAP how much of its
# own voice the assistant tolerates. HALF_DUPLEX=1 is the old behaviour: mute the mic while
# speaking (headphones-free, but no barge-in).
BARGE_IN=1
BARGE_VAD_THRESHOLD=0.7
BARGE_MIN_MS=250
BARGE_CONFIRM_WORDS=3
ECHO_OVERLAP=0.6
HALF_DUPLEX=0

# ── turn-taking judge (DECISION_MODE=auto asks it on every ambiguous pause) ────
# Empty = the judge shares LLM_BASE_URL / LLM_MODEL (today's behaviour). Set them to
# run the 4-token LISTEN/REPLY verdict on a second, smaller llama-server: a pause then
# never queues behind a streaming answer, and answers ~4× faster warm.
# A dead endpoint degrades turn-taking to «always reply».
#DECISION_BASE_URL=http://127.0.0.1:8098/v1
#DECISION_MODEL=FrogNano-4B-2609-Q4_K_M
#DECISION_MODE=auto        # off | auto | always

# ── tool gate (same judge, different question: which of the tools the model just
#    proposed does the user's latest message actually ask for?) ───────────────
# A small model with tools re-runs the previous turn's tool for any vague follow-up
# ("prova" after an interrupted answer → get_datetime); the gate denies those calls
# with a hint to answer with a spoken sentence instead. Judge failure → no gate.
# `read_skill` / `list_skills` are never judged: they only load context (the call that
# acts on them, run_command, is gated as usual).
TOOL_GATE=1

# ── model files (`bun run models-download` fetches ≈3.3 GiB into MODELS_DIR; add
#    `--check` to only verify them — the list itself is derived from this file) ──
MODELS_DIR=./models
VAD_MODEL=./models/silero/silero_vad.onnx

# ── skills: SKILL.md packages (~/.pi/agent/skills by default, `~` is expanded).
#    Which skills are *active* is chosen in the UI settings drawer, not here.
SKILLS_DIR=~/.pi/agent/skills

# ── commands, prompts, data ──────────────────────────────────────────────────
CMD_MODE=auto                # off | ask | auto — approval policy for run_command
CMD_TIMEOUT_S=30
# How long a spoken/clickable "may I run it?" waits before it is taken as a no
CMD_APPROVAL_TIMEOUT_S=60
SYSTEM_PROMPT_FILE=./prompts/system.txt
DECISION_PROMPT_FILE=./prompts/decision.txt
TOOL_GATE_PROMPT_FILE=./prompts/tool-gate.txt
DATA_DIR=./data
# Keep the conversation across restarts: the transcript, the model's history and the ⟲
# checkpoint ids are written to <DATA_DIR>/chat.json (0 = always start with an empty chat;
# scripts/ui-test.sh sets 0 so the suite never overwrites yours)
CHAT_PERSIST=1
DEBUG=0
