# /etc/sonia-gtk4/env — configuration for the packaged sonia-gtk4 client.
# Sourced by /usr/bin/sonia-gtk4 before the app starts; variables already set in
# your shell always win. Optional: copy to ~/.config/sonia-gtk4/env for a
# per-user override.

# harness base URL (the process serving /ws)
HARNESS_URL=http://127.0.0.1:8095

# UI language: it | en
LOCALE=it

# PipeWire capture/playback device, e.g. fd_ec_source / fd_ec_sink
# (leave empty for the PipeWire default device)
#MIC_TARGET=fd_ec_source
#SPK_TARGET=fd_ec_sink

# Start with the echo-canceller engaged: 1 | 0
#SONIA_AEC=1
